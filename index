<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BLACKOUT PROTOCOL — Tactical Ops</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');

* { margin:0; padding:0; box-sizing:border-box; }
html,body { width:100%; height:100%; overflow:hidden; background:#000; font-family:'Oswald',sans-serif; }
canvas { display:block; }

#crosshair {
  position:fixed; top:50%; left:50%; width:0; height:0; pointer-events:none; z-index:20;
}
.ch-line { position:absolute; background:#e8e8e0; opacity:0.9; box-shadow:0 0 3px rgba(0,0,0,0.8); }
.ch-top,.ch-bottom { width:2px; height:8px; left:-1px; }
.ch-left,.ch-right { height:2px; width:8px; top:-1px; }
.ch-top { top:-16px; } .ch-bottom { top:8px; }
.ch-left { left:-16px; } .ch-right { left:8px; }
.ch-dot { position:absolute; width:3px; height:3px; left:-1.5px; top:-1.5px; background:#ff6b1a; border-radius:50%; }

#vignette {
  position:fixed; inset:0; pointer-events:none; z-index:15;
  box-shadow: inset 0 0 220px 60px rgba(255,0,0,0);
  transition: box-shadow 0.15s ease-out;
}

#hud { position:fixed; inset:0; pointer-events:none; z-index:10; color:#e8e8e0; font-family:'Oswald',sans-serif; }
.panel {
  position:absolute; background:linear-gradient(135deg, rgba(10,14,10,0.78), rgba(10,14,10,0.55));
  border:1px solid rgba(120,140,110,0.35); backdrop-filter: blur(2px);
}

/* Bottom-left: health */
#healthWrap { left:24px; bottom:24px; width:280px; padding:12px 16px; clip-path: polygon(0 0, 100% 0, 100% 70%, 92% 100%, 0 100%); }
#healthLabel { font-size:11px; letter-spacing:3px; color:#9cb08a; margin-bottom:6px; display:flex; justify-content:space-between; }
#healthBarBg { width:100%; height:16px; background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.15); position:relative; overflow:hidden; }
#healthBarFill { height:100%; width:100%; background:linear-gradient(90deg,#c1272d,#ff5a3c); transition: width 0.2s; }
#healthNum { font-family:'Share Tech Mono',monospace; font-size:22px; margin-top:6px; color:#ff8a70; text-shadow:0 0 8px rgba(255,90,60,0.5); }

/* Bottom-right: ammo/weapon */
#weaponWrap { right:24px; bottom:24px; width:280px; padding:12px 16px; text-align:right; clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%, 0 70%); }
#weaponName { font-size:14px; letter-spacing:2px; color:#ffb156; font-weight:600; }
#ammoNum { font-family:'Share Tech Mono',monospace; font-size:30px; color:#ffe9b0; text-shadow:0 0 8px rgba(255,200,100,0.4); }
#ammoReserve { font-family:'Share Tech Mono',monospace; font-size:14px; color:#8a9a7a; }
#reloadBar { margin-top:4px; height:4px; width:100%; background:rgba(0,0,0,0.5); display:none; }
#reloadFill { height:100%; width:0%; background:#3ad6ff; }
#weaponSlots { display:flex; gap:6px; justify-content:flex-end; margin-top:8px; }
.slot { width:26px; height:26px; border:1px solid rgba(255,255,255,0.25); display:flex; align-items:center; justify-content:center; font-size:11px; font-family:'Share Tech Mono',monospace; color:#8a9a7a; }
.slot.active { border-color:#ffb156; color:#ffb156; box-shadow:0 0 8px rgba(255,177,86,0.4); }

#grenadeWrap { position:absolute; right:24px; bottom:150px; text-align:right; font-family:'Share Tech Mono',monospace; font-size:13px; color:#c9d6b8; }

/* Top center: objective */
#objectiveWrap { top:18px; left:50%; transform:translateX(-50%); padding:8px 26px; text-align:center; min-width:340px; clip-path: polygon(4% 0,96% 0,100% 100%,0 100%); }
#objTitle { font-size:11px; letter-spacing:4px; color:#ffb156; }
#objText { font-size:15px; letter-spacing:1px; margin-top:2px; }

/* Compass */
#compass { position:absolute; top:70px; left:50%; transform:translateX(-50%); width:200px; text-align:center; }
#objArrow { display:inline-block; font-size:18px; color:#3ad6ff; transition: transform 0.15s linear; text-shadow:0 0 6px rgba(58,214,255,0.7); }

/* Top-left: kill feed */
#killFeed { top:18px; left:18px; width:280px; }
.feedItem { font-size:13px; padding:4px 10px; margin-bottom:4px; background:rgba(10,14,10,0.6); border-left:3px solid #ff6b1a; color:#dfe6d2; animation: fadeIn 0.2s; }
@keyframes fadeIn { from{opacity:0; transform:translateX(-10px);} to{opacity:1; transform:translateX(0);} }

/* Top-right: minimap + rank */
#topRight { top:18px; right:18px; display:flex; flex-direction:column; align-items:flex-end; gap:8px; }
#minimapWrap { width:170px; height:170px; border:1px solid rgba(120,140,110,0.4); background:rgba(5,8,5,0.6); position:relative; }
#rankPanel { width:210px; padding:8px 12px; text-align:right; }
#rankName { font-size:14px; color:#ffe9b0; letter-spacing:1px; font-weight:600; }
#xpBarBg { width:100%; height:6px; background:rgba(0,0,0,0.5); margin-top:5px; }
#xpBarFill { height:100%; width:0%; background:linear-gradient(90deg,#3ad6ff,#8affc1); }
#xpText { font-family:'Share Tech Mono',monospace; font-size:10px; color:#8a9a7a; margin-top:2px; }

/* prompts */
#promptWrap { bottom:190px; left:50%; transform:translateX(-50%); padding:8px 20px; text-align:center; display:none; }
#promptWrap.show { display:block; }
#promptText { font-size:14px; letter-spacing:1px; color:#fff; }
#promptText b { color:#ffb156; }
#actionBarBg { width:220px; height:5px; background:rgba(0,0,0,0.5); margin-top:6px; display:none; }
#actionBarFill { height:100%; width:0%; background:#ff6b1a; }

#rankUpToast, #missionToast {
  position:fixed; top:35%; left:50%; transform:translate(-50%,-50%); text-align:center; z-index:30;
  opacity:0; transition: opacity 0.4s, transform 0.4s; pointer-events:none;
}
#rankUpToast.show, #missionToast.show { opacity:1; transform:translate(-50%,-60%); }
#rankUpToast .big, #missionToast .big { font-size:34px; letter-spacing:6px; color:#ffb156; font-weight:700; text-shadow:0 0 20px rgba(255,177,86,0.8); }
#rankUpToast .small, #missionToast .small { font-size:15px; letter-spacing:3px; color:#dfe6d2; margin-top:6px; }

/* Overlays */
.overlay {
  position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center;
  background: radial-gradient(circle at 50% 40%, rgba(20,26,18,0.92), rgba(4,6,4,0.98));
  flex-direction:column; text-align:center; color:#e8e8e0;
}
.hidden { display:none !important; }
.title { font-size:52px; letter-spacing:10px; font-weight:700; color:#ffb156; text-shadow:0 0 30px rgba(255,140,50,0.5); }
.subtitle { font-size:15px; letter-spacing:6px; color:#8fae7a; margin-top:10px; margin-bottom:34px; }
.startBtn {
  pointer-events:auto; cursor:pointer; font-family:'Oswald',sans-serif; font-size:18px; letter-spacing:4px; font-weight:600;
  background:linear-gradient(135deg,#3a5a2f,#24361c); color:#e8f0d8; border:1px solid #7fae5a; padding:16px 46px;
  clip-path: polygon(6% 0,100% 0,94% 100%,0 100%); transition: all 0.15s;
}
.startBtn:hover { background:linear-gradient(135deg,#4c7a3d,#345226); box-shadow:0 0 24px rgba(140,200,90,0.35); }
.instructions { margin-top:38px; display:grid; grid-template-columns:1fr 1fr; gap:8px 40px; text-align:left; font-family:'Share Tech Mono',monospace; font-size:13px; color:#a9baa0; }
.instructions b { color:#ffe9b0; display:inline-block; min-width:80px; }
.statsBlock { margin:20px 0 30px; font-family:'Share Tech Mono',monospace; font-size:16px; color:#c9d6b8; line-height:1.9; }
.statsBlock span { color:#ffb156; }
#loadingNote { position:fixed; bottom:14px; right:18px; font-family:'Share Tech Mono',monospace; font-size:11px; color:#5a6a52; z-index:60; }
</style>
</head>
<body>

<div id="vignette"></div>

<div id="crosshair">
  <div class="ch-line ch-top" id="chTop"></div>
  <div class="ch-line ch-bottom" id="chBottom"></div>
  <div class="ch-line ch-left" id="chLeft"></div>
  <div class="ch-line ch-right" id="chRight"></div>
  <div class="ch-dot"></div>
</div>

<div id="hud">
  <div id="healthWrap" class="panel">
    <div id="healthLabel"><span>VITALS</span><span id="healthPct">100%</span></div>
    <div id="healthBarBg"><div id="healthBarFill"></div></div>
    <div id="healthNum">100</div>
  </div>

  <div id="weaponWrap" class="panel">
    <div id="weaponName">M9 PISTOL</div>
    <div id="ammoNum">12</div>
    <div id="ammoReserve">RESERVE 60</div>
    <div id="reloadBar"><div id="reloadFill"></div></div>
    <div id="weaponSlots">
      <div class="slot" data-i="0">1</div><div class="slot" data-i="1">2</div>
      <div class="slot" data-i="2">3</div><div class="slot" data-i="3">4</div>
      <div class="slot" data-i="4">5</div>
    </div>
  </div>

  <div id="grenadeWrap">GRENADES: <span id="grenadeCount">3</span> [G]</div>

  <div id="objectiveWrap" class="panel">
    <div id="objTitle">MISSION OBJECTIVE</div>
    <div id="objText">Eliminate all hostiles (0/8)</div>
  </div>
  <div id="compass"><div id="objArrow">▲ OBJ</div></div>

  <div id="killFeed"></div>

  <div id="topRight">
    <div id="minimapWrap"><canvas id="minimapCanvas" width="170" height="170"></canvas></div>
    <div id="rankPanel" class="panel">
      <div id="rankName">RECRUIT</div>
      <div id="xpBarBg"><div id="xpBarFill"></div></div>
      <div id="xpText">0 / 150 XP</div>
    </div>
  </div>

  <div id="promptWrap" class="panel">
    <div id="promptText">Press <b>F</b> to enter vehicle</div>
    <div id="actionBarBg"><div id="actionBarFill"></div></div>
  </div>
</div>

<div id="rankUpToast"><div class="big">RANK UP</div><div class="small" id="rankUpText">SERGEANT</div></div>
<div id="missionToast"><div class="big" id="missionToastBig">OBJECTIVE UPDATED</div><div class="small" id="missionToastSmall"></div></div>

<div id="startOverlay" class="overlay">
  <div class="title">BLACKOUT PROTOCOL</div>
  <div class="subtitle">TACTICAL OPERATIONS UNIT — NIGHT INSERTION</div>
  <div class="instructions">
    <div><b>WASD</b> Move</div><div><b>MOUSE</b> Look</div>
    <div><b>LMB</b> Fire</div><div><b>RMB</b> Aim</div>
    <div><b>R</b> Reload</div><div><b>1-5 / Scroll</b> Switch weapon</div>
    <div><b>G</b> Throw grenade</div><div><b>B</b> Plant bomb (hold)</div>
    <div><b>F</b> Enter/exit vehicle</div><div><b>Shift</b> Sprint</div>
    <div><b>Ctrl</b> Crouch</div><div><b>Space</b> Jump</div>
    <div><b>Esc</b> Pause</div><div><b>E</b> Interact</div>
  </div>
  <div class="startBtn" id="startBtn">▶ DEPLOY</div>
</div>

<div id="pauseOverlay" class="overlay hidden">
  <div class="title" style="font-size:38px;">PAUSED</div>
  <div style="margin-top:30px; display:flex; gap:20px;">
    <div class="startBtn" id="resumeBtn">RESUME</div>
    <div class="startBtn" id="restartBtnPause">RESTART</div>
  </div>
</div>

<div id="gameOverOverlay" class="overlay hidden">
  <div class="title" style="color:#ff4c3c; text-shadow:0 0 30px rgba(255,50,30,0.6);">KIA</div>
  <div class="subtitle" style="color:#c98a7a;">MISSION FAILED</div>
  <div class="statsBlock">
    HOSTILES ELIMINATED: <span id="goKills">0</span><br>
    RANK ACHIEVED: <span id="goRank">Recruit</span><br>
    TIME IN THEATER: <span id="goTime">0:00</span>
  </div>
  <div class="startBtn" id="restartBtnGO">RESTART OPERATION</div>
</div>

<div id="victoryOverlay" class="overlay hidden">
  <div class="title" style="color:#8affc1; text-shadow:0 0 30px rgba(120,255,180,0.6);">MISSION COMPLETE</div>
  <div class="subtitle" style="color:#8fae7a;">EXTRACTION SUCCESSFUL</div>
  <div class="statsBlock">
    HOSTILES ELIMINATED: <span id="vKills">0</span><br>
    PACKAGES RECOVERED: <span id="vPackages">0</span><br>
    FINAL RANK: <span id="vRank">Recruit</span><br>
    TOTAL XP: <span id="vXP">0</span><br>
    TIME IN THEATER: <span id="vTime">0:00</span>
  </div>
  <div class="startBtn" id="restartBtnV">DEPLOY AGAIN</div>
</div>

<div id="loadingNote">BLACKOUT PROTOCOL v1.0 — Three.js Engine</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ============================================================
   BLACKOUT PROTOCOL — single-file Three.js FPS
   ============================================================ */

// ---------- Utility ----------
const rand = (a,b)=>a+Math.random()*(b-a);
const clamp = (v,a,b)=>Math.max(a,Math.min(b,v));
const lerp = (a,b,t)=>a+(b-a)*t;
function randomPointAround(cx,cz,minR,maxR){
  const ang = Math.random()*Math.PI*2, r = rand(minR,maxR);
  return {x:cx+Math.cos(ang)*r, z:cz+Math.sin(ang)*r};
}

// ---------- Core three.js setup ----------
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x8fa8bd);
scene.fog = new THREE.Fog(0x8fa8bd, 45, 170);

const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 500);
const defaultFov = 75, aimFov = 45;

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

window.addEventListener('resize', ()=>{
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// ---------- Lighting ----------
const hemi = new THREE.HemisphereLight(0x9fb8cc, 0x33321f, 0.75);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff2d8, 1.15);
sun.position.set(60,90,40);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left = -110; sun.shadow.camera.right = 110;
sun.shadow.camera.top = 110; sun.shadow.camera.bottom = -110;
sun.shadow.camera.far = 260;
sun.shadow.bias = -0.0015;
scene.add(sun);
const fillLight = new THREE.AmbientLight(0x404850, 0.35);
scene.add(fillLight);

// ---------- Ground ----------
function makeGroundTexture(){
  const c = document.createElement('canvas'); c.width=256; c.height=256;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#4c5a3c'; ctx.fillRect(0,0,256,256);
  for(let i=0;i<4200;i++){
    const x=Math.random()*256, y=Math.random()*256;
    const shade = Math.random()*40-20;
    ctx.fillStyle = `rgba(${20+shade<0?0:20+shade},${30+shade<0?0:30+shade},${14+shade<0?0:14+shade},0.5)`;
    ctx.fillRect(x,y,2,2);
  }
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(50,50);
  return tex;
}
const groundGeo = new THREE.PlaneGeometry(240,240);
const groundMat = new THREE.MeshStandardMaterial({map: makeGroundTexture(), roughness:1});
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

// ---------- Map generation ----------
let obstacleColliders = [];  // {x,z,r}
let obstacleMeshes = [];     // THREE.Object3D for raycasting
let healthPacks = [];
let packages = [];
let enemies = [];
let bombZone, extractZone, vehicle;
const mapHalf = 96;

function clearGroup(list, removeFromScene){
  list.forEach(o=>{ if(removeFromScene) scene.remove(o.mesh||o.group||o); });
}

function buildBuilding(x,z){
  const w = rand(7,13), d = rand(7,13), h = rand(7,18);
  const g = new THREE.Group();
  const bodyMat = new THREE.MeshStandardMaterial({color: new THREE.Color().setHSL(0.08,0.06,rand(0.28,0.42)), roughness:0.95});
  const body = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), bodyMat);
  body.position.y = h/2; body.castShadow = true; body.receiveShadow = true;
  g.add(body);
  // roof cap
  const roof = new THREE.Mesh(new THREE.BoxGeometry(w+0.4,0.4,d+0.4), new THREE.MeshStandardMaterial({color:0x2a2a26}));
  roof.position.y = h+0.2; roof.castShadow = true;
  g.add(roof);
  // window strip emissive
  const winMat = new THREE.MeshStandardMaterial({color:0xffdd88, emissive:0xffbb55, emissiveIntensity:0.6});
  for(let i=0;i<3;i++){
    const win = new THREE.Mesh(new THREE.BoxGeometry(w*0.9,0.6,0.05), winMat);
    win.position.set(0, h*0.3+i*h*0.28, d/2+0.03);
    g.add(win);
  }
  g.position.set(x,0,z);
  scene.add(g);
  obstacleMeshes.push(g);
  obstacleColliders.push({x,z,r:Math.max(w,d)/2+0.5});
}
function buildCrate(x,z){
  const s = rand(1.0,1.8);
  const mat = new THREE.MeshStandardMaterial({color:0x6b4a2a, roughness:0.9});
  const m = new THREE.Mesh(new THREE.BoxGeometry(s,s,s), mat);
  m.position.set(x,s/2,z); m.rotation.y = rand(0,Math.PI);
  m.castShadow = true; m.receiveShadow = true;
  scene.add(m);
  obstacleMeshes.push(m);
  obstacleColliders.push({x,z,r:s*0.75});
}
function buildTree(x,z){
  const g = new THREE.Group();
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.4,3,7), new THREE.MeshStandardMaterial({color:0x4a3520}));
  trunk.position.y = 1.5; trunk.castShadow = true;
  const leaves = new THREE.Mesh(new THREE.ConeGeometry(2.2,4.5,8), new THREE.MeshStandardMaterial({color:0x2f4a26}));
  leaves.position.y = 4.5; leaves.castShadow = true;
  g.add(trunk,leaves); g.position.set(x,0,z);
  scene.add(g);
  obstacleMeshes.push(g);
  obstacleColliders.push({x,z,r:1.0});
}

function farEnoughFromCenter(x,z,min){ return Math.hypot(x,z) > min; }

function generateMap(){
  // buildings
  for(let i=0;i<9;i++){
    let x,z; let tries=0;
    do{ x = rand(-mapHalf+15,mapHalf-15); z = rand(-mapHalf+15,mapHalf-15); tries++; }
    while(!farEnoughFromCenter(x,z,16) && tries<30);
    buildBuilding(x,z);
  }
  // crates
  for(let i=0;i<16;i++){
    let x,z,tries=0;
    do{ x = rand(-mapHalf+8,mapHalf-8); z = rand(-mapHalf+8,mapHalf-8); tries++; }
    while(!farEnoughFromCenter(x,z,10) && tries<30);
    buildCrate(x,z);
  }
  // trees
  for(let i=0;i<14;i++){
    let x,z,tries=0;
    do{ x = rand(-mapHalf+5,mapHalf-5); z = rand(-mapHalf+5,mapHalf-5); tries++; }
    while(!farEnoughFromCenter(x,z,10) && tries<30);
    buildTree(x,z);
  }

  // health packs
  for(let i=0;i<6;i++){
    const p = randomPointAround(0,0,20,mapHalf-10);
    healthPacks.push(makeHealthPack(p.x,p.z));
  }

  // intel packages
  for(let i=0;i<4;i++){
    const p = randomPointAround(0,0,25,mapHalf-15);
    packages.push(makePackage(p.x,p.z));
  }

  // enemies
  for(let i=0;i<8;i++){
    const p = randomPointAround(0,0,20,mapHalf-8);
    enemies.push(makeEnemy(p.x,p.z));
  }

  // bomb zone / extract zone at opposite corners
  const bombPos = new THREE.Vector3(-mapHalf+18, 0, -mapHalf+18);
  const extractPos = new THREE.Vector3(mapHalf-18, 0, mapHalf-18);
  bombZone = makeZoneMarker(bombPos, 0xff4c3c);
  extractZone = makeZoneMarker(extractPos, 0x4cff8a);

  // vehicle
  vehicle = makeVehicle(18,-12);
}

// ---------- Health pack ----------
function makeHealthPack(x,z){
  const g = new THREE.Group();
  const base = new THREE.Mesh(new THREE.BoxGeometry(0.7,0.5,0.7), new THREE.MeshStandardMaterial({color:0xffffff, roughness:0.6}));
  base.position.y=0.25; base.castShadow=true;
  const crossMat = new THREE.MeshStandardMaterial({color:0xff2e2e, emissive:0xaa0000, emissiveIntensity:0.4});
  const c1 = new THREE.Mesh(new THREE.BoxGeometry(0.45,0.15,0.1), crossMat); c1.position.set(0,0.25,0.36);
  const c2 = new THREE.Mesh(new THREE.BoxGeometry(0.15,0.45,0.1), crossMat); c2.position.set(0,0.25,0.36);
  g.add(base,c1,c2);
  g.position.set(x,0,z);
  scene.add(g);
  return {group:g, x, z, collected:false};
}

// ---------- Intel package ----------
function makePackage(x,z){
  const g = new THREE.Group();
  const box = new THREE.Mesh(new THREE.BoxGeometry(0.6,0.6,0.6), new THREE.MeshStandardMaterial({color:0x1a2a33, emissive:0x1ad6ff, emissiveIntensity:0.5, roughness:0.4}));
  box.castShadow = true;
  g.add(box);
  g.position.set(x,1.1,z);
  scene.add(g);
  const light = new THREE.PointLight(0x3ad6ff, 1.2, 6);
  light.position.set(x,1.4,z);
  scene.add(light);
  return {group:g, light, x, z, collected:false, baseY:1.1};
}

// ---------- Zone markers ----------
function makeZoneMarker(pos, color){
  const ring = new THREE.Mesh(new THREE.RingGeometry(4.6,5,32), new THREE.MeshBasicMaterial({color, side:THREE.DoubleSide, transparent:true, opacity:0.7}));
