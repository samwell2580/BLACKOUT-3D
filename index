// ---------- Player-facing helpers ----------
function resolveCollisions(pos, radius, list){
  for(const o of list){
    const dx = pos.x-o.x, dz = pos.z-o.z;
    const dist = Math.hypot(dx,dz);
    const minDist = radius+o.r;
    if(dist<minDist){
      const d = dist<0.0001?0.0001:dist;
      const push = (minDist-d);
      pos.x += (dx/d)*push;
      pos.z += (dz/d)*push;
    }
  }
}
function clampBounds(pos){
  pos.x = clamp(pos.x,-mapHalf+2,mapHalf-2);
  pos.z = clamp(pos.z,-mapHalf+2,mapHalf-2);
}

