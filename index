// ---------- Grenades ----------
function throwGrenade(){
  if(gameState!=='playing' || controlMode!=='foot') return;
  if(grenadeCount<=0){ playSound('empty'); return; }
  grenadeCount--;
  const dir = new THREE.Vector3(); camera.getWorldDirection(dir);
  const mesh = new THREE.Mesh(new THREE.SphereGeometry(0.13,8,8), new THREE.MeshStandardMaterial({color:0x2f2f1a}));
  mesh.castShadow = true;
  mesh.position.copy(camera.position).add(dir.clone().multiplyScalar(0.7));
  scene.add(mesh);
  const vel = dir.clone().multiplyScalar(16); vel.y += 7;
  grenades.push({mesh, vel, spawnTime:performance.now(), exploded:false});
  playSound('throw');
}
function updateGrenades(dt){
  for(const g of grenades){
    if(g.exploded) continue;
    g.vel.y -= 20*dt;
    g.mesh.position.addScaledVector(g.vel, dt);
    if(g.mesh.position.y<0.13){ g.mesh.position.y=0.13; g.vel.y*=-0.4; g.vel.x*=0.7; g.vel.z*=0.7; }
    if(performance.now()-g.spawnTime>2400) explodeGrenade(g);
  }
  for(let i=grenades.length-1;i>=0;i--) if(grenades[i].removeMe) grenades.splice(i,1);
}
function explodeGrenade(g){
  g.exploded = true; g.removeMe = true;
  scene.remove(g.mesh);
  spawnExplosion(g.mesh.position.clone());
  playSound('explosion');
  camShakeAmt = 0.5; camShakeTime = 0.4;
  enemies.forEach(en=>{
    if(en.dead) return;
    const d = en.group.position.distanceTo(g.mesh.position);
    if(d<9) damageEnemy(en, Math.max(0,95*(1-d/9)));
  });
  if(controlMode==='foot'){
    const dP = camera.position.distanceTo(g.mesh.position);
    if(dP<9) damagePlayer(Math.max(0,55*(1-dP/9)));
  }
}

