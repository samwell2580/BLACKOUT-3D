function tryReload(){
  const w = weapons[currentWeaponIndex];
  if(controlMode!=='foot') return;
  if(w.reloading || w.currentAmmo>=w.maxMag || w.reserveAmmo<=0) return;
  w.reloading = true; w.reloadStart = performance.now();
  playSound('reload');
}

let lastShotTime = 0;
function shoot(){
  const w = weapons[currentWeaponIndex];
  if(w.reloading) return;
  const now = performance.now();
  if(now-lastShotTime < w.fireRate) return;
  if(w.currentAmmo<=0){ playSound('empty'); lastShotTime = now; return; }
  lastShotTime = now;
  w.currentAmmo--;
  muzzleLight.intensity = 3.2;
  pitchKick += w.recoil;
  playSound('shot', w);

  const aimMul = aiming?0.35:1;
  const moveMul = (velocity.x!==0||velocity.z!==0)?1.5:1;
  const spread = w.spread*aimMul*moveMul;

  const hittable = [...obstacleMeshes, ...enemies.filter(en=>!en.dead).map(en=>en.group)];
  const muzzleWorld = new THREE.Vector3();
  viewModelGroup.getWorldPosition(muzzleWorld);

  for(let p=0;p<w.pellets;p++){
    const ox = (Math.random()-0.5)*spread*2;
    const oy = (Math.random()-0.5)*spread*2;
    raycaster.setFromCamera({x:ox,y:oy}, camera);
    const hits = raycaster.intersectObjects(hittable, true);
    if(hits.length){
      const hit = hits[0];
      spawnTracer(muzzleWorld, hit.point);
      const enemy = findEnemyFromHit(hit.object);
      if(enemy && !enemy.dead){
        let dmg = w.dmg;
        if(hit.object.name==='head') dmg *= 2.2;
        damageEnemy(enemy, dmg);
      } else {
        spawnImpactSpark(hit.point);
      }
    } else {
      const dir = new THREE.Vector3(); camera.getWorldDirection(dir);
      spawnTracer(muzzleWorld, muzzleWorld.clone().add(dir.multiplyScalar(120)));
    }
  }
}

function damageEnemy(enemy, dmg){
  enemy.health -= dmg;
  if(enemy.health<=0 && !enemy.dead) killEnemy(enemy);
}
function killEnemy(enemy){
