// ---------- Audio ----------
let audioCtx = null;
function initAudio(){ try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} }
function beep(freq,dur,vol,type){
  if(!audioCtx) return;
  const o = audioCtx.createOscillator(), g = audioCtx.createGain();
  o.type = type||'sine'; o.frequency.value = freq;
  g.gain.value = vol;
  o.connect(g); g.connect(audioCtx.destination);
  const t = audioCtx.currentTime;
  o.start(t);
  g.gain.exponentialRampToValueAtTime(0.001, t+dur);
  o.stop(t+dur+0.02);
}
function playNoise(dur,vol,lowpass){
  if(!audioCtx) return;
  const bufferSize = Math.floor(audioCtx.sampleRate*dur);
  const buffer = audioCtx.createBuffer(1,bufferSize,audioCtx.sampleRate);
  const data = buffer.getChannelData(0);
  for(let i=0;i<bufferSize;i++) data[i]=(Math.random()*2-1)*(1-i/bufferSize);
  const noise = audioCtx.createBufferSource(); noise.buffer = buffer;
  const g = audioCtx.createGain(); g.gain.value = vol;
  if(lowpass){
    const f = audioCtx.createBiquadFilter(); f.type='lowpass'; f.frequency.value = lowpass;
    noise.connect(f); f.connect(g);
  } else { noise.connect(g); }
  g.connect(audioCtx.destination);
  noise.start();
}
function playSound(type, weapon){
  if(!audioCtx) return;
  if(type==='shot'){
    const o=audioCtx.createOscillator(), g=audioCtx.createGain();
    o.type='square';
    const base = weapon && weapon.name.includes('SNIPER') ? 150 : (weapon && weapon.name.includes('SHOTGUN') ? 70 : 100);
    o.frequency.setValueAtTime(base, audioCtx.currentTime);
    o.frequency.exponentialRampToValueAtTime(28, audioCtx.currentTime+0.09);
    g.gain.setValueAtTime(0.3, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+0.11);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime+0.12);
    playNoise(0.07,0.22,2200);
  } else if(type==='empty'){ beep(180,0.08,0.15,'square'); }
  else if(type==='enemyShot'){ playNoise(0.06,0.14,1600); }
  else if(type==='explosion'){ playNoise(0.7,0.55,90); beep(60,0.4,0.3,'sawtooth'); }
  else if(type==='throw'){ beep(500,0.08,0.12,'sine'); }
  else if(type==='reload'){ beep(600,0.06,0.14,'square'); setTimeout(()=>beep(820,0.06,0.14,'square'),160); }
  else if(type==='pickup'){ beep(880,0.09,0.18,'sine'); setTimeout(()=>beep(1300,0.09,0.15,'sine'),90); }
  else if(type==='hurt'){ playNoise(0.2,0.2,500); }
  else if(type==='kill'){ beep(220,0.05,0.1,'square'); }
  else if(type==='jump'){ beep(300,0.06,0.08,'sine'); }
  else if(type==='rankup'){ beep(660,0.15,0.2,'sine'); setTimeout(()=>beep(880,0.2,0.2,'sine'),150); setTimeout(()=>beep(1100,0.25,0.2,'sine'),320); }
  else if(type==='beep'){ beep(700,0.1,0.15,'sine'); }
  else if(type==='engine'){ /* handled elsewhere */ }
}

