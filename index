// ---------- Vehicle control ----------
function tryToggleVehicle(){
  if(gameState!=='playing') return;
  if(controlMode==='foot'){
    const dist = Math.hypot(camera.position.x-vehicle.group.position.x, camera.position.z-vehicle.group.position.z);
    if(dist<4.5){
      controlMode='vehicle';
      vehicle.occupied = true;
    }
  } else {
    controlMode='foot';
    vehicle.occupied = false;
    camera.position.set(vehicle.group.position.x+2.5, player.eyeHeight, vehicle.group.position.z);
  }
}
function updateVehicle(dt){
  const accel = 14, maxSpeed = 26, maxReverse = -10, friction = 0.985, turnRate = 1.6;
  if(keys['KeyW']) vehicle.speed += accel*dt;
  if(keys['KeyS']) vehicle.speed -= accel*dt;
  vehicle.speed *= friction;
  vehicle.speed = clamp(vehicle.speed, maxReverse, maxSpeed);
  if(Math.abs(vehicle.speed)>0.3){
    const turnDir = vehicle.speed>=0?1:-1;
    if(keys['KeyA']) vehicle.yaw += turnRate*dt*turnDir;
    if(keys['KeyD']) vehicle.yaw -= turnRate*dt*turnDir;
  }
  if(keys['Space']) vehicle.speed *= 0.9;
  const forward = new THREE.Vector3(Math.sin(vehicle.yaw),0,Math.cos(vehicle.yaw));
  const newPos = {x: vehicle.group.position.x+forward.x*vehicle.speed*dt, z: vehicle.group.position.z+forward.z*vehicle.speed*dt};
  resolveCollisions(newPos, 1.6, obstacleColliders);
  clampBounds(newPos);
  vehicle.group.position.x = newPos.x; vehicle.group.position.z = newPos.z;
  vehicle.group.rotation.y = vehicle.yaw;
  vehicle.wheels.forEach(w=>{ w.rotation.x += vehicle.speed*dt*1.5; });

  // run-over kill
  if(Math.abs(vehicle.speed)>9){
    enemies.forEach(en=>{
      if(en.dead) return;
      const d = en.group.position.distanceTo(vehicle.group.position);
      if(d<2.6){ damageEnemy(en, 999); xp += 10; }
    });
  }

  camera.position.set(vehicle.group.position.x, vehicle.group.position.y+1.55, vehicle.group.position.z);
}

// ---------- Enemy AI ----------
function hasLineOfSight(from,to){
  const dir = new THREE.Vector3().subVectors(to,from);
  const dist = dir.length();
  dir.normalize();
  raycaster.set(from, dir);
  raycaster.far = dist;
  const hits = raycaster.intersectObjects(obstacleMeshes, true);
  raycaster.far = 200;
  return hits.length===0;
}
function updateEnemies(dt){
  const playerPos = controlMode==='vehicle' ? vehicle.group.position : camera.position;
  const now = performance.now();
  enemies.forEach(en=>{
    if(en.dead){
      if(en.group.rotation.x > -1.55){ en.group.rotation.x -= dt*4; }
      return;
    }
    const enPos3 = en.group.position;
    const dist = Math.hypot(enPos3.x-playerPos.x, enPos3.z-playerPos.z);
    const eyePos = enPos3.clone().add(new THREE.Vector3(0,1.6,0));
    const targetEye = new THREE.Vector3(playerPos.x, 1.5, playerPos.z);
    const los = dist<en.alertRange ? hasLineOfSight(eyePos,targetEye) : false;

    if(dist<en.alertRange && los){
      en.state = dist<en.attackRange ? 'attack' : 'chase';
      en.lastSeenTime = now;
    } else if(now-en.lastSeenTime>3500){
      en.state = 'patrol';
    }

    if(en.state==='patrol'){
      const tx=en.patrolTarget.x, tz=en.patrolTarget.z;
      const d = Math.hypot(tx-enPos3.x, tz-enPos3.z);
      if(d<1.2){ en.patrolTarget = randomPointAround(en.patrolCenter.x, en.patrolCenter.z, 4,14); }
      else {
        const dirX=(tx-enPos3.x)/d, dirZ=(tz-enPos3.z)/d;
        const np = {x:enPos3.x+dirX*en.speed*0.4*dt, z:enPos3.z+dirZ*en.speed*0.4*dt};
        resolveCollisions(np,0.5,obstacleColliders); clampBounds(np);
        en.group.position.x=np.x; en.group.position.z=np.z;
        en.group.rotation.y = Math.atan2(dirX,dirZ);
      }
    } else if(en.state==='chase'){
      const dirX=(playerPos.x-enPos3.x), dirZ=(playerPos.z-enPos3.z);
      const d = Math.hypot(dirX,dirZ)||1;
      const np = {x:enPos3.x+(dirX/d)*en.speed*dt, z:enPos3.z+(dirZ/d)*en.speed*dt};
      resolveCollisions(np,0.5,obstacleColliders); clampBounds(np);
      en.group.position.x=np.x; en.group.position.z=np.z;
      en.group.rotation.y = Math.atan2(dirX,dirZ);
    } else if(en.state==='attack'){
      const dirX=(playerPos.x-enPos3.x), dirZ=(playerPos.z-enPos3.z);
      en.group.rotation.y = Math.atan2(dirX,dirZ);
      if(now-en.lastFire > en.fireCooldown){
        en.lastFire = now;
        const hitChance = clamp(1-dist/en.attackRange,0.15,0.8);
        const muzzle = enPos3.clone().add(new THREE.Vector3(Math.sin(en.group.rotation.y+0.3)*0.4,1.1,Math.cos(en.group.rotation.y+0.3)*0.4));
        spawnTracer(muzzle, new THREE.Vector3(playerPos.x, 1.4, playerPos.z));
        playSound('enemyShot');
        if(Math.random()<hitChance){ damagePlayer(rand(5,15)); }
      }
    }
  });
}

// ---------- Pickups ----------
function updatePickups(dt){
  const playerPos = controlMode==='vehicle' ? vehicle.group.position : camera.position;
  for(let i=healthPacks.length-1;i>=0;i--){
    const hp = healthPacks[i];
    hp.group.rotation.y += dt*1.5;
    const d = Math.hypot(hp.x-playerPos.x, hp.z-playerPos.z);
    if(d<2.2 && controlMode==='foot' && player.health<player.maxHealth){
      player.health = clamp(player.health+45,0,player.maxHealth);
      scene.remove(hp.group);
      healthPacks.splice(i,1);
      playSound('pickup');
      addKillFeed('<span style="color:#ff8a70">+45 HEALTH</span>');
    }
  }
  for(let i=packages.length-1;i>=0;i--){
    const pk = packages[i];
    pk.group.rotation.y += dt*1.8;
    pk.group.position.y = pk.baseY + Math.sin(performance.now()*0.002+i)*0.15;
    pk.light.position.copy(pk.group.position);
    const d = Math.hypot(pk.x-playerPos.x, pk.z-playerPos.z);
    if(d<2.2 && controlMode==='foot'){
      scene.remove(pk.group); scene.remove(pk.light);
      packages.splice(i,1);
      packagesCollected++;
      xp += 30;
      playSound('pickup');
      addKillFeed('INTEL RECOVERED <span style="color:#8affc1">+30 XP</span>');
      checkRankUp();
    }
  }
}

// ---------- Mission logic ----------
let promptText = '';
let promptProgress = -1;
function updateMission(dt){
  const playerPos = camera.position;
  promptText = ''; promptProgress = -1;

  if(missionStage==='eliminate'){
    if(kills>=totalEnemies){
      missionStage='collect';
      showMissionToast('OBJECTIVE UPDATED','RECOVER THE INTEL PACKAGES');
    }
  } else if(missionStage==='collect'){
    if(packagesCollected>=totalPackages){
      missionStage='plant';
      showMissionToast('OBJECTIVE UPDATED','PLANT THE CHARGE AT MARKED SITE');
    }
  } else if(missionStage==='plant'){
    const d = Math.hypot(playerPos.x-bombZone.position.x, playerPos.z-bombZone.position.z);
    if(controlMode==='foot' && d<bombZone.radius){
      promptText = 'Hold <b>B</b> to plant charge';
      if(keys['KeyB']){
        bombZone.planting = true;
        bombZone.progress += dt/3.0;
        promptProgress = clamp(bombZone.progress,0,1);
        if(bombZone.progress>=1 && !bombZone.planted){
          bombZone.planted = true;
          xp += 100;
          spawnExplosion(bombZone.position.clone());
          playSound('explosion');
          missionStage='extract';
          showMissionToast('CHARGE PLANTED','RETURN TO EXTRACTION POINT');
          checkRankUp();
        }
      } else {
        bombZone.progress = Math.max(0,bombZone.progress-dt*0.6);
      }
    } else {
      bombZone.progress = Math.max(0,bombZone.progress-dt*0.6);
    }
  } else if(missionStage==='extract'){
    const d = Math.hypot(playerPos.x-extractZone.position.x, playerPos.z-extractZone.position.z);
    if(controlMode==='foot' && d<extractZone.radius){
      xp += 150;
      checkRankUp();
      victory();
    } else if(d<extractZone.radius+25){
      promptText = 'Reach the <b>extraction zone</b>';
    }
  }

  // vehicle enter/exit prompt
  if(controlMode==='foot' && missionStage!=='plant'){
    const dv = Math.hypot(playerPos.x-vehicle.group.position.x, playerPos.z-vehicle.group.position.z);
    if(dv<4.5) promptText = 'Press <b>F</b> to enter vehicle';
  } else if(controlMode==='vehicle'){
    promptText = 'Press <b>F</b> to exit vehicle';
  }
}

function objectivePosition(){
  if(missionStage==='eliminate'){
    const alive = enemies.filter(e=>!e.dead);
    if(!alive.length) return null;
    let nearest=alive[0], nd=Infinity;
    alive.forEach(e=>{ const d=e.group.position.distanceTo(camera.position); if(d<nd){nd=d; nearest=e;} });
    return nearest.group.position;
  }
  if(missionStage==='collect'){
    if(!packages.length) return null;
    let nearest=packages[0], nd=Infinity;
    packages.forEach(p=>{ const d=Math.hypot(p.x-camera.position.x,p.z-camera.position.z); if(d<nd){nd=d;nearest=p;} });
    return new THREE.Vector3(nearest.x,1,nearest.z);
  }
  if(missionStage==='plant') return bombZone.position;
  if(missionStage==='extract') return extractZone.position;
  return null;
}

function objectiveText(){
  if(missionStage==='eliminate') return `Eliminate all hostiles (${kills}/${totalEnemies})`;
  if(missionStage==='collect') return `Recover intel packages (${packagesCollected}/${totalPackages})`;
  if(missionStage==='plant') return `Plant the charge at the marked site`;
  if(missionStage==='extract') return `Return to the extraction zone`;
  return '';
}

// ---------- Game flow ----------
function startGame(){
  gameState = 'playing';
  startTime = performance.now();
  initAudio();
  document.getElementById('startOverlay').classList.add('hidden');
  camera.fov = defaultFov; camera.updateProjectionMatrix();
  camera.position.set(0, player.eyeHeight, 6);
  yaw = Math.PI; pitch = 0;
  renderer.domElement.requestPointerLock && renderer.domElement.requestPointerLock().catch(()=>{});
  clock.getDelta();
}
function togglePause(){
  if(gameState==='playing'){
    gameState='paused';
    document.getElementById('pauseOverlay').classList.remove('hidden');
    if(document.exitPointerLock) document.exitPointerLock();
  } else if(gameState==='paused'){
    gameState='playing';
    document.getElementById('pauseOverlay').classList.add('hidden');
    renderer.domElement.requestPointerLock && renderer.domElement.requestPointerLock().catch(()=>{});
    clock.getDelta();
  }
}
function gameOver(){
  gameState='gameover';
  document.getElementById('goKills').textContent = kills;
  document.getElementById('goRank').textContent = ranks[currentRankIndex].name;
  document.getElementById('goTime').textContent = formatTime(performance.now()-startTime);
  document.getElementById('gameOverOverlay').classList.remove('hidden');
  if(document.exitPointerLock) document.exitPointerLock();
}
function victory(){
  if(gameState==='victory') return;
  gameState='victory';
  document.getElementById('vKills').textContent = kills;
  document.getElementById('vPackages').textContent = packagesCollected;
  document.getElementById('vRank').textContent = ranks[currentRankIndex].name;
  document.getElementById('vXP').textContent = xp;
  document.getElementById('vTime').textContent = formatTime(performance.now()-startTime);
  document.getElementById('victoryOverlay').classList.remove('hidden');
  if(document.exitPointerLock) document.exitPointerLock();
}
function formatTime(ms){
  const s = Math.floor(ms/1000);
  return `${Math.floor(s/60)}:${(s%60).toString().padStart(2,'0')}`;
}

document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', togglePause);
document.getElementById('restartBtnPause').addEventListener('click', ()=>location.reload());
document.getElementById('restartBtnGO').addEventListener('click', ()=>location.reload());
document.getElementById('restartBtnV').addEventListener('click', ()=>location.reload());

document.addEventListener('pointerlockchange', ()=>{
  if(document.pointerLockElement!==renderer.domElement && gameState==='playing'){
    togglePause();
  }
});

// ---------- Player movement ----------
function updatePlayerMovement(dt){
  const isCrouching = !!keys['ControlLeft'] || !!keys['ControlRight'];
  const isSprinting = (keys['ShiftLeft']||keys['ShiftRight']) && !isCrouching;
  const targetEye = isCrouching ? player.crouchHeight : player.eyeHeight;
  player.currentEyeHeight = lerp(player.currentEyeHeight, targetEye, Math.min(1,dt*8));

  if(keys['Space'] && player.jumpHeight<=0.001){ player.jumpVel = 6.6; playSound('jump'); }
  player.jumpVel -= 19*dt;
  player.jumpHeight += player.jumpVel*dt;
  if(player.jumpHeight<0){ player.jumpHeight=0; player.jumpVel=0; }

  const forward = new THREE.Vector3(); camera.getWorldDirection(forward); forward.y=0; forward.normalize();
  const right = new THREE.Vector3().crossVectors(forward, camera.up).normalize();

  let mx=0, mz=0;
  if(keys['KeyW']) mz+=1;
  if(keys['KeyS']) mz-=1;
  if(keys['KeyD']) mx+=1;
  if(keys['KeyA']) mx-=1;
  const len = Math.hypot(mx,mz);
  const moving = len>0;
  if(moving){ mx/=len; mz/=len; }

  let speed = 5.6 * (isCrouching?0.5:1) * (isSprinting?1.7:1) * (aiming?0.6:1);
  velocity.x = (right.x*mx + forward.x*mz)*speed;
  velocity.z = (right.z*mx + forward.z*mz)*speed;

  const newPos = {x:camera.position.x+velocity.x*dt, z:camera.position.z+velocity.z*dt};
  resolveCollisions(newPos, 0.42, obstacleColliders);
  clampBounds(newPos);
  camera.position.x = newPos.x; camera.position.z = newPos.z;
  camera.position.y = player.currentEyeHeight + player.jumpHeight;

  // view bob
  if(moving && player.jumpHeight<0.01){
    bobTime += dt*(isSprinting?15:9.5);
  }
  const bob = (moving && player.jumpHeight<0.01) ? Math.sin(bobTime)*0.035 : 0;
  viewModelGroup.position.y = -0.28 + bob*0.6;
  viewModelGroup.position.x = 0.28 + Math.cos(bobTime*0.5)*0.01;

  if(!moving) velocity.x=velocity.z=0;
}

function updateCameraRotation(dt){
  pitchKick = lerp(pitchKick,0,Math.min(1,dt*9));
  camera.rotation.set(pitch+pitchKick, yaw, 0, 'YXZ');

  // aim FOV
  const targetFov = aiming && controlMode==='foot' ? aimFov : defaultFov;
  camera.fov = lerp(camera.fov, targetFov, Math.min(1,dt*10));
  camera.updateProjectionMatrix();

  // camera shake
  if(camShakeTime>0){
    camShakeTime -= dt;
    const s = camShakeAmt*(camShakeTime>0?1:0);
    camera.rotation.x += (Math.random()-0.5)*s*0.06;
    camera.rotation.y += (Math.random()-0.5)*s*0.06;
  }

  muzzleLight.intensity = lerp(muzzleLight.intensity,0,Math.min(1,dt*14));
  viewModelGroup.visible = controlMode==='foot';
}

// ---------- Effects update ----------
function updateEffects(){
  const now = performance.now();
  for(let i=tracers.length-1;i>=0;i--){
    if(now-tracers[i].start>80){ scene.remove(tracers[i].line); tracers.splice(i,1); }
  }
  for(let i=impactSparks.length-1;i>=0;i--){
    const s = impactSparks[i];
    const t=(now-s.start)/300;
    if(t>=1){ scene.remove(s.mesh); impactSparks.splice(i,1); continue; }
    s.mesh.material.opacity = 1-t; s.mesh.scale.setScalar(1+t*2);
  }
  for(let i=explosionEffects.length-1;i>=0;i--){
    const e = explosionEffects[i];
    const t=(now-e.start)/420;
    if(t>=1){ scene.remove(e.mesh); scene.remove(e.light); explosionEffects.splice(i,1); continue; }
    e.mesh.scale.setScalar(1+t*7);
    e.mesh.material.opacity = 1-t;
    e.light.intensity = (1-t)*6;
  }
}

// ---------- HUD update ----------
const healthBarFill = document.getElementById('healthBarFill');
const healthNum = document.getElementById('healthNum');
const healthPct = document.getElementById('healthPct');
const weaponNameEl = document.getElementById('weaponName');
const ammoNumEl = document.getElementById('ammoNum');
const ammoReserveEl = document.getElementById('ammoReserve');
const reloadBar = document.getElementById('reloadBar');
const reloadFill = document.getElementById('reloadFill');
const grenadeCountEl = document.getElementById('grenadeCount');
const objTextEl = document.getElementById('objText');
const objArrowEl = document.getElementById('objArrow');
const killFeedEl = document.getElementById('killFeed');
const rankNameEl = document.getElementById('rankName');
const xpBarFillEl = document.getElementById('xpBarFill');
const xpTextEl = document.getElementById('xpText');
const promptWrapEl = document.getElementById('promptWrap');
const promptTextEl = document.getElementById('promptText');
const actionBarBg = document.getElementById('actionBarBg');
const actionBarFill = document.getElementById('actionBarFill');
const slots = document.querySelectorAll('.slot');
const minimapCanvas = document.getElementById('minimapCanvas');
const mmCtx = minimapCanvas.getContext('2d');

function updateHUD(){
  // health
  const hpPct = Math.round((player.health/player.maxHealth)*100);
  healthBarFill.style.width = hpPct+'%';
  healthNum.textContent = Math.round(player.health);
  healthPct.textContent = hpPct+'%';
  healthBarFill.style.background = hpPct<30 ? 'linear-gradient(90deg,#7a0f12,#c1272d)' : 'linear-gradient(90deg,#c1272d,#ff5a3c)';

  // weapon
  if(controlMode==='foot'){
    const w = weapons[currentWeaponIndex];
    weaponNameEl.textContent = w.name;
    ammoNumEl.textContent = w.currentAmmo;
    ammoReserveEl.textContent = 'RESERVE '+w.reserveAmmo;
    if(w.reloading){
      const t = clamp((performance.now()-w.reloadStart)/w.reloadTime,0,1);
      reloadBar.style.display='block'; reloadFill.style.width=(t*100)+'%';
      if(t>=1){
        const needed = w.maxMag-w.currentAmmo;
        const take = Math.min(needed,w.reserveAmmo);
        w.currentAmmo += take; w.reserveAmmo -= take; w.reloading=false;
      }
    } else { reloadBar.style.display='none'; }
    slots.forEach((s,i)=>{ s.classList.toggle('active', i===currentWeaponIndex); });
  } else {
    weaponNameEl.textContent = 'DRIVING';
    ammoNumEl.textContent = '--';
    ammoReserveEl.textContent = 'VEHICLE MODE';
    reloadBar.style.display='none';
  }
  grenadeCountEl.textContent = grenadeCount;

  // objective
  objTextEl.textContent = objectiveText();
  const objPos = objectivePosition();
  if(objPos){
    const forward = new THREE.Vector3(); camera.getWorldDirection(forward);
    const facingAngle = Math.atan2(forward.x, forward.z);
    const dx = objPos.x-camera.position.x, dz = objPos.z-camera.position.z;
    const objAngle = Math.atan2(dx,dz);
    let diff = objAngle-facingAngle;
    while(diff>Math.PI) diff-=Math.PI*2;
    while(diff<-Math.PI) diff+=Math.PI*2;
    objArrowEl.style.transform = `rotate(${diff}rad)`;
    objArrowEl.parentElement.style.opacity='1';
  } else {
    objArrowEl.parentElement.style.opacity='0.3';
  }

  // kill feed
  const now = performance.now();
  killFeedItems = killFeedItems.filter(k=>now-k.t<4000);
  killFeedEl.innerHTML = killFeedItems.map(k=>`<div class="feedItem">${k.html}</div>`).join('');

  // rank
  rankNameEl.textContent = ranks[currentRankIndex].name;
  const nextRank = ranks[currentRankIndex+1];
  if(nextRank){
    const span = nextRank.xp - ranks[currentRankIndex].xp;
    const prog = clamp((xp-ranks[currentRankIndex].xp)/span,0,1);
    xpBarFillEl.style.width = (prog*100)+'%';
    xpTextEl.textContent = `${xp} / ${nextRank.xp} XP`;
  } else {
    xpBarFillEl.style.width='100%';
    xpTextEl.textContent = `${xp} XP — MAX RANK`;
  }

  // prompt
  if(promptText){
    promptWrapEl.classList.add('show');
    promptTextEl.innerHTML = promptText;
    if(promptProgress>=0){ actionBarBg.style.display='block'; actionBarFill.style.width=(promptProgress*100)+'%'; }
    else { actionBarBg.style.display='none'; }
  } else {
    promptWrapEl.classList.remove('show');
  }

  // crosshair spread visual
  const w2 = weapons[currentWeaponIndex];
  const spreadPx = controlMode==='foot' ? clamp(8 + w2.spread*260*(aiming?0.35:1),8,40) : 8;
  document.getElementById('chTop').style.transform = `translateY(-${spreadPx}px)`;
  document.getElementById('chBottom').style.transform = `translateY(${spreadPx}px)`;
  document.getElementById('chLeft').style.transform = `translateX(-${spreadPx}px)`;
  document.getElementById('chRight').style.transform = `translateX(${spreadPx}px)`;

  drawMinimap();
}

function drawMinimap(){
  const w=170,h=170, scale=0.75;
  mmCtx.clearRect(0,0,w,h);
  mmCtx.fillStyle = 'rgba(20,30,18,0.4)';
  mmCtx.fillRect(0,0,w,h);
  const px = controlMode==='vehicle'?vehicle.group.position.x:camera.position.x;
  const pz = controlMode==='vehicle'?vehicle.group.position.z:camera.position.z;
  const toMap = (x,z)=>({mx: w/2+(x-px)*scale, my: h/2+(z-pz)*scale});

  // obstacles
  mmCtx.fillStyle = 'rgba(140,150,120,0.35)';
  obstacleColliders.forEach(o=>{
    const p = toMap(o.x,o.z);
    if(p.mx>-10&&p.mx<w+10&&p.my>-10&&p.my<h+10) mmCtx.fillRect(p.mx-2,p.my-2,4,4);
  });
  // health packs
  mmCtx.fillStyle = '#ff5a5a';
  healthPacks.forEach(hp=>{ const p=toMap(hp.x,hp.z); mmCtx.fillRect(p.mx-2,p.my-2,4,4); });
  // packages
  mmCtx.fillStyle = '#3ad6ff';
  packages.forEach(pk=>{ const p=toMap(pk.x,pk.z); mmCtx.beginPath(); mmCtx.arc(p.mx,p.my,3,0,7); mmCtx.fill(); });
  // enemies
  enemies.forEach(en=>{
    if(en.dead) return;
    const p = toMap(en.group.position.x, en.group.position.z);
    mmCtx.fillStyle = en.state==='attack'?'#ff2222':(en.state==='chase'?'#ff8a2a':'#cc4444');
    mmCtx.beginPath(); mmCtx.arc(p.mx,p.my,3,0,7); mmCtx.fill();
  });
  // vehicle
  if(!vehicle.occupied){
    const p = toMap(vehicle.group.position.x, vehicle.group.position.z);
    mmCtx.fillStyle = '#4c8aff';
    mmCtx.fillRect(p.mx-3,p.my-3,6,6);
  }
  // zones
  mmCtx.strokeStyle = '#ff4c3c'; mmCtx.lineWidth=1.5;
  let p = toMap(bombZone.position.x,bombZone.position.z);
  mmCtx.beginPath(); mmCtx.arc(p.mx,p.my,5,0,7); mmCtx.stroke();
  mmCtx.strokeStyle = '#4cff8a';
  p = toMap(extractZone.position.x,extractZone.position.z);
  mmCtx.beginPath(); mmCtx.arc(p.mx,p.my,5,0,7); mmCtx.stroke();

  // player triangle
  const forward = new THREE.Vector3(); camera.getWorldDirection(forward);
  const ang = Math.atan2(forward.x,forward.z);
  mmCtx.save();
  mmCtx.translate(w/2,h/2); mmCtx.rotate(ang);
  mmCtx.fillStyle = '#ffe9b0';
  mmCtx.beginPath(); mmCtx.moveTo(0,-6); mmCtx.lineTo(4,5); mmCtx.lineTo(-4,5); mmCtx.closePath(); mmCtx.fill();
  mmCtx.restore();
}

// ---------- Main loop ----------
const clock = new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(),0.05);

  if(gameState==='menu'){
    const t = clock.elapsedTime;
    camera.position.set(Math.sin(t*0.06)*34, 16, Math.cos(t*0.06)*34);
    camera.lookAt(0,3,0);
  } else if(gameState==='playing'){
    if(mouseDown && weapons[currentWeaponIndex].auto && controlMode==='foot') shoot();
    if(controlMode==='vehicle') updateVehicle(dt); else updatePlayerMovement(dt);
    updateCameraRotation(dt);
    updateEnemies(dt);
    updateGrenades(dt);
    updatePickups(dt);
    updateMission(dt);
    updateEffects();
    updateHUD();
  }

  renderer.render(scene,camera);
}
animate();
</script>
